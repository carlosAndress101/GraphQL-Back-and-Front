# Build context = repo root (docker build -f apps/api/Dockerfile .)
**/node_modules
.git
**/.env
**/.env.*
!**/.env.example
**/dist
**/coverage
**/*.tsbuildinfo
.worktrees
.github
docs
**/*.log
# The persisted-documents manifest ships inside the API image (production
# trusted documents). Never ignore it.
!apps/web/src/gql/persisted-documents.json
