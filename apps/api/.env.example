NODE_ENV=development
PORT=4000
# Neon connection string (use the `dev` branch locally). Must include sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/app?sslmode=require
# Comma-separated exact origins. Production: https://app.<your-domain>
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_DAYS=30
# none | cloudflare (trust CF-Connecting-IP when running behind Cloudflare Tunnel)
TRUST_PROXY=none
LOG_LEVEL=info
# Optional. When set, traces and metrics are exported via OTLP.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway.example.com/otlp
