{
  "name": "@app/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import ./src/instrumentation.ts --env-file-if-exists=.env src/server.ts",
    "start": "node --import ./src/instrumentation.ts src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node src/migrate.ts",
    "codegen": "graphql-codegen"
  },
  "dependencies": {
    "@envelop/opentelemetry": "^9.2.2",
    "@escape.tech/graphql-armor": "^3.2.0",
    "@graphql-yoga/plugin-csrf-prevention": "^3.24.2",
    "@graphql-yoga/plugin-disable-introspection": "^2.25.2",
    "@graphql-yoga/plugin-persisted-operations": "^3.24.2",
    "@hono/node-server": "^2.1.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.45.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@graphql-codegen/cli": "^7.4.5",
    "@graphql-codegen/typescript": "^6.1.1",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
